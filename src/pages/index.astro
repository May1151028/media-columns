---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { outletColor, formatDate } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const outlets = [...new Set(posts.map((p) => p.data.outlet))];
---
<Base>
  {posts.length === 0 ? (
    <p class="empty">目前還沒有文章。</p>
  ) : (
    <>
      <nav class="filters" aria-label="依媒體篩選">
        <button type="button" data-filter="" aria-pressed="true">全部（{posts.length}）</button>
        {outlets.map((o) => (
          <button type="button" data-filter={o} aria-pressed="false" style={`--c:${outletColor(o)}`}>
            {o}（{posts.filter((p) => p.data.outlet === o).length}）
          </button>
        ))}
      </nav>

      <ol class="entries">
        {posts.map((p) => (
          <li class="entry" data-outlet={p.data.outlet} style={`--c:${outletColor(p.data.outlet)}`}>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <div class="entry-body">
              <h2><a href={`${base}/articles/${p.id}/`}>{p.data.title}</a></h2>
              <p class="outlet">{p.data.outlet}</p>
              {p.data.summary && <p class="summary">{p.data.summary}</p>}
            </div>
          </li>
        ))}
      </ol>
    </>
  )}
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const entries = document.querySelectorAll<HTMLElement>('.entry');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      entries.forEach((e) => {
        e.hidden = f !== '' && e.dataset.outlet !== f;
      });
    });
  });
</script>
